

<!-- MAIN CONTENT -->
<div id="admin-content">
    <div class="container">
        <div class="row">

            <div class="col-md-12">
                <h1 class="admin-heading">Update Category</h1>
            </div>

            <div class="col-md-offset-3 col-md-6">
                <!-- UPDATE FORM -->
                <form action="/admin/update-category/<%= category._id %>" method="post"  autocomplete="off">

                    <input type="hidden" class="form-control" value="1">

                    <div class="form-group">
                        <label for="post_title">Title</label>
                        <input
                        name="name"
                            type="text"
                            id="post_title"
                            class="form-control"
                            value="<%= category.name %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="post_desc">Description</label>
                        <textarea
                           name="description"
                            id="post_desc"
                            class="form-control"
                            rows="5"
                            required
                        ><%= category.description %></textarea>
                    </div>

                  

                   

                    <input type="submit" class="btn btn-primary" value="Update">

                </form>
                <!-- /UPDATE FORM -->
                 <!-- Error Message -->
                          <%- include('../partials/error') %> 
                <!-- /Error Message -->
            </div>

        </div>
    </div>
</div>

