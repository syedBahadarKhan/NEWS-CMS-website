 <!-- Tabulator JavaScript -->
<script type="text/javascript" src="https://unpkg.com/tabulator-tables/dist/js/tabulator.min.js"></script>
<script>
  const tableData = <%- JSON.stringify(categories) %>;
//   console.log(tableData);
   
 var table = new Tabulator("#categoriesTable", {
    data: tableData,
    layout: "fitColumns",
    pagination: true,
    paginationSize: 10,
    columns: [
     { title: "S.NO.", formatter: "rownum", hozAlign: "center", width: 100 },
      { title: "Category Name", field: "name", headerFilter: "input" },
      { title: "Slug", field: "slug", headerFilter: "input" },
    
      {
        title: "Actions",
        formatter: function (cell, formatterParams, onRendered) {
          return `
            <a href="/admin/update-category/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
            <button class="btn btn-sm btn-danger"
              onclick="deleteCategory('${cell.getData()._id}')">Delete</button>
          `;
        }
      }
    ]
  });

  
  



  //Delete Category function
  async function deleteCategory(id){
    try{
      if(confirm("Are you sure to delte this category")){
       const response= await fetch(`/admin/delete-category/${id}`, {
          method:"delete"
        });
        if(response.ok){
          window.location.reload();
        }

        if(response.status == 400){
          const data = await response.json();
          alert(data.message)
        }
      }

    }catch(err){
      console.error(err);
    }
  }
</script>

