

<!-- MAIN CONTENT -->
<div id="admin-content">
    <div class="container">
        <div class="row">

            <div class="col-md-12">
                <h1 class="admin-heading">Update Article</h1>
            </div>

            <div class="col-md-offset-3 col-md-6">
              
            <form action="/admin/update-article/<%= article._id %>" method="POST" autocomplete="off" enctype="multipart/form-data">

                    <div class="form-group">
                        <label for="post_title">Title</label>
                        <input
                            name="title"
                            type="text"
                            id="post_title"
                            class="form-control"
                            value="<%= article.title %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="post_desc">Description</label>
                        <textarea
                            name="content"
                            id="summernote"
                            class="form-control"
                            rows="5"
                            required
                        ><%= article.content %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="category">Category</label>
                        <select id="category" name="category" class="form-control" required>
                            <% categories.forEach(category => { %>
                                <option value="<%= category._id %>" <%= article.category.id == category._id ? "selected" : "" %>>
                                    <%= category.name %>
                                </option>
                            <% }); %>
                        </select>
                    </div>

                <div class="form-group">
                    <label class="form-label">Post Image</label><br>
                    <img src="/uploads/<%= article.image %>" alt="Article Image" style="width: 100px; height: 100px; margin-bottom: 10px; border: 3px solid #3f79ff;">
                    <input type="file" name="image" class="form-control">
                    <br>
                </div>

                <input type="submit" class="btn btn-primary" value="Update">

</form>

                <!-- Error Message -->
                        <%- include('../partials/error') %> 
                <!-- /Error Message -->

                
            </div>

        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
<script>
  $(document).ready(function () {
    $('#summernote').summernote({
      placeholder: 'Start typing...',
      tabsize: 2,
      height: 200
    });
  });


  document.querySelector('form').addEventListener("submit", function (event) {
        const unwantedfield = document.querySelector('input[type= "file"]')
        if(unwantedfield) {
            unwantedfield.remove();
        }
  })

</script>




<%- contentFor("summernoteCSS") %>
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
