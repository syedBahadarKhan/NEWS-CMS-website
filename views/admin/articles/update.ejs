

<!-- MAIN CONTENT -->
<div id="admin-content">
    <div class="container">
        <div class="row">

            <div class="col-md-12">
                <h1 class="admin-heading">Update Article</h1>
            </div>

            <div class="col-md-offset-3 col-md-6">
                <!-- UPDATE FORM -->
                <form action="/admin/article/update/<%= article._id %>" method="post" enctype="multipart/form-data" autocomplete="off">

                    <input type="hidden" class="form-control" value="1">

                    <div class="form-group">
                        <label for="post_title">Title</label>
                        <input
                            type="text"
                            id="post_title"
                            class="form-control"
                            value="<%= article.title %>"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="post_desc">Description</label>
                        <textarea
                            id="summernote"
                            class="form-control"
                            rows="5"
                            required
                        ><%= article.content %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="category">Category</label>
                        <select id="category" class="form-control" required>
                            <% categories.forEach(category => { %>
                                <% if(article.category.id == category._id) { %>
                                    <% } else { %>
                                <option value="<%= category._id %>" selected><%= category.name %></option>
                                <% } %>
                                <% });%>
                        </select>
                    </div>

                    <div class="form-group">
                        <label  class="form-label">Post Image</label><br>
                         <img src="/uploads/<%= article.image %>" alt="Article Image" style="width: 100px; height: 100px; margin-bottom: 10px; border: 3px solid #3f79ff;">
                        <input type="file" class="form-control">
                        <br>
                       
                    </div>

                    <input type="submit" class="btn btn-primary" value="Update">

                </form>
                <!-- /UPDATE FORM -->
            </div>

        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
<script>
  $(document).ready(function () {
    $('#summernote').summernote({
      placeholder: 'Start typing...',
      tabsize: 2,
      height: 200
    });
  });

</script>




<%- contentFor("summernoteCSS") %>
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css" rel="stylesheet">
