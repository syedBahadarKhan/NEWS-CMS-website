  <div id="admin-content">
      <div class="container">
          <div class="row">
              <div class="col-md-10">
                  <h1 class="admin-heading"><i class="fa fa-file-text"></i> All Articles</h1>
              </div>
              <div class="col-md-2">
                  <a class="add-new" href="/admin/add-article">Add New Article</a>
              </div>
              <div class="col-md-12">
                 <div id="articleTable"></div>
              </div>
          </div>
      </div>
  </div>







   <!-- Tabulator JavaScript -->
<script type="text/javascript" src="https://unpkg.com/tabulator-tables/dist/js/tabulator.min.js"></script>
<script>
  const tableData = <%- JSON.stringify(articles) %>;
//   console.log(tableData);
   
 var table = new Tabulator("#articleTable", {
    data: tableData,
    layout: "fitColumns",
    pagination: true,
    paginationSize: 10,
    columns: [
     { title: "S.NO.", formatter: "rownum", hozAlign: "center", width: 100 },
      { title: "Title", field: "title", headerFilter: "input" },
      { title: "Date", field: "craetedAt", headerFilter: "input",
       formatter: function(cell, formatterParams, onRendered) {
        const date = new Date(cell.getValue());
        return date.toLocaleDateString('en-GB', {day: '2-digit', month: 'short', year: 'numeric' }).replace(/\s/g, '-');
      }},
      { title: "Category", field: "category.name"},
       { title: "Author", field: "author.fullname"},
    
      {
        title: "Actions",
        formatter: function (cell, formatterParams, onRendered) {
          return `
            <a href="/admin/update-article/${cell.getData()._id}" class="btn btn-sm btn-success">Edit</a>
            <button class="btn btn-sm btn-danger"
              onclick="deleteArticle('${cell.getData()._id}')">Delete</button>
          `;
        }
      }
    ]
  });

  
  



  //Delete Article function
  async function deleteArticle(id){
    try{
      if(confirm("Are you sure to delete this article")){
       const response= await fetch(`/admin/delete-article/${id}`, {
          method:"delete"
        });
        if(response.ok){
          window.location.reload();
        }
      }

    }catch(err){
      console.error(err);
    }
  }
</script>

<%- contentFor('tabulatorCSS') %>
 <link href="https://unpkg.com/tabulator-tables@6.2.5/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
