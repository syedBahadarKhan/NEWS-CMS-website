<!-- post-container -->
    <div class="post-container">
      <div class="post-content single-post">
        <h3><%= SingleArticles.title %> </h3>
        <div class="post-information">
          <span>
            <i class="fa fa-tags" aria-hidden="true"></i>
            <a href="/category/<%= SingleArticles.category.slug %>"><%= SingleArticles.category.name %></a>
          </span>
          <span>
            <i class="fa fa-user" aria-hidden="true"></i>
            <a href='/author/<%= SingleArticles.author._id %>'><%= SingleArticles.author.fullname %></a>
          </span>
          <span>
            <i class="fa fa-calendar" aria-hidden="true"></i>
           <%= new Date(SingleArticles.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) %>
          </span>
        </div>
        <img class="single-feature-image" src="/uploads/<%= SingleArticles.image %>" alt=""/>
        <div>
          <%- SingleArticles.content %>
        </div>
      </div>
    </div>



    <!-- Comments Section -->
    <div class="comments-section mt-5">
      <h3>Comments</h3>
      
      <!-- Comment Form -->
      <div class="card mb-4">
          <div class="card-body">
              <form action="/single/comment" method="POST">
                  <div class="mb-3">
                      <label class="form-label">Name</label>
                      <input type="text" class="form-control" name="name" required>
                  </div>
                  <div class="mb-3">
                      <label class="form-label">Email</label>
                      <input type="email" class="form-control" name="email" required>
                  </div>
                  <div class="mb-3">
                      <label class="form-label">Comment</label>
                      <textarea class="form-control" name="content" rows="3" required></textarea>
                  </div>
                  <button type="submit" class="btn btn-primary">Submit Comment</button>
              </form>
          </div>
      </div>

      <!-- Display Comments -->
  </div>
